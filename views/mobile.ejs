    <p class="vacio" id="vacio" hidden>No hay productos con esos filtros.</p>
  </main>

  <script>
    (function () {
      var q = document.getElementById('q');
      var r = document.getElementById('precio');
      var pv = document.getElementById('pv');
      var cards = document.querySelectorAll('.card');
      var vacio = document.getElementById('vacio');

      function filtrar() {
        var texto = q.value.trim().toLowerCase();
        var max = Number(r.value);
        var visibles = 0;
        pv.textContent = '$' + max.toLocaleString('es-MX');
        cards.forEach(function (c) {
          var ok = c.dataset.nombre.indexOf(texto) !== -1 && Number(c.dataset.precio) <= max;
          c.hidden = !ok;
          if (ok) visibles++;
        });
        vacio.hidden = visibles > 0;
      }

      q.addEventListener('input', filtrar);
      r.addEventListener('input', filtrar);
    })();
  </script>
</body>
</html>