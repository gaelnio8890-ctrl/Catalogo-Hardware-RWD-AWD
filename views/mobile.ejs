<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Catalogo de Hardware</title>
  <link rel="icon" href="data:,">
  <style>
    *{box-sizing:border-box}
    body{margin:0;font-family:system-ui,-apple-system,sans-serif;background:#f4f8fc;color:#222}
    header{background:#14213D;color:#FCA311;padding:12px 16px}
    header h1{margin:0 0 6px;font-size:1.25rem}
    nav a{color:#FCA311;text-decoration:none;font-size:.9rem;margin-right:14px}
    .filtros{background:#fff;padding:12px 16px;border-bottom:1px solid #e5e7eb;display:grid;gap:8px}
    .filtros input[type=text]{width:100%;padding:10px;border:1px solid #cbd5e1;border-radius:8px;font-size:1rem}
    .filtros input[type=range]{width:100%}
    .lista{padding:12px;display:grid;gap:12px}
    .card{background:#fff;border-radius:8px;padding:10px;display:flex;gap:10px;box-shadow:0 1px 4px rgba(0,0,0,.08)}
    .card img{width:90px;height:90px;object-fit:contain;flex-shrink:0;background:#f1f5f9;border-radius:6px}
    .info{flex:1;min-width:0}
    .info h3{margin:0 0 4px;font-size:.95rem;line-height:1.25;color:#14213D}
    .specs{margin:0;padding:0;list-style:none;font-size:.78rem;color:#555}
    .pie{display:flex;justify-content:space-between;align-items:center;margin-top:8px}
    .precio{font-weight:700;color:#14213D}
    .btn{background:#007bff;color:#fff;border:0;border-radius:4px;padding:8px 12px;font-size:.85rem}
    .vacio{text-align:center;color:#64748b;padding:24px}
    [hidden]{display:none!important}
  </style>
</head>
<body>
  <header>
    <h1>Catálogo de Hardware</h1>
    <nav><a href="#">Inicio</a><a href="#">Productos</a><a href="#">Contacto</a></nav>
  </header>

  <section class="filtros" aria-label="Filtros">
    <input type="text" id="q" placeholder="Buscar producto" autocomplete="off">
    <label for="precio">Precio máximo: <b id="pv">$50,000</b></label>
    <input type="range" id="precio" min="1000" max="50000" step="500" value="50000">
  </section>

  <main class="lista" aria-label="Catálogo de productos">

    <article class="card" data-nombre="laptop msi" data-precio="21199">
