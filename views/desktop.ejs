<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Catalogo de Hardware</title>
  <link rel="icon" href="data:,"> <!-- favicon vacío para evitar errores de carga -->
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <header class="header">
    <div class="logo">
      <h1>Catálogo de Hardware</h1> 
    </div>
    <nav class="menu">
      <ul>
        <li><a href="#">Inicio</a></li>
        <li><a href="#">Productos</a></li>
        <li><a href="#">Contacto</a></li>
      </ul>
    </nav>
  </header>

  <div class="contenido">
    <details class="panel-controles" id="panel-controles" aria-label="Filtros y comparación" open>
      <summary>Filtros y comparación</summary>
      <div class="controles-interiores">
        <section class="filtros" aria-label="Filtros">
          <h2>Filtros</h2>

          <label for="q">Buscar</label>
          <input type="text" id="q" placeholder="Nombre del producto">

          <label for="precio">Precio máximo: <b id="pv">$50,000</b></label>
          <input type="range" id="precio" min="5000" max="50000" step="500" value="50000">

          <label for="ram">RAM mínima</label>
          <select id="ram">
            <option value="0">Cualquiera</option>
            <option value="8">8 GB</option>
            <option value="16">16 GB</option>
            <option value="32">32 GB</option>
          </select>

          <label for="sto">Almacenamiento mínimo</label>
          <select id="sto">
            <option value="0">Cualquiera</option>
            <option value="128">128 GB</option>
            <option value="256">256 GB</option>
            <option value="512">512 GB</option>
          </select>

          <button type="button" id="reset" class="btn-limpiar">Limpiar filtros</button>
        </section>

        <section class="grafica" aria-label="Comparación">
          <h2>Comparación</h2>
          <button type="button" id="limpiar-comparacion" class="btn-limpiar-comparacion" hidden>
            Limpiar comparación
          </button>
          <div id="grafica">
            <p class="vacio">Marca "Comparar" en 2 o 3 productos.</p>
          </div>
          <canvas id="chart" width="400" height="200"></canvas>
        </section>
      </div>
    </details>

